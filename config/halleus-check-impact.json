      "guards": [
        "check:secure-admin-core",
        "check:admin-origin-boundary",
        "check:auth-readiness",
        "check:full-wiki-cms",
        "check:wiki-scheduling-determinism",
        "check:vps-release-workflow",
        "check:wiki-queue-operations",

    },
    {
      "id": "full-wiki-cms-guard",
      "description": "Focused self-verification for check:full-wiki-cms.",
      "exclusive": true,
      "patterns": [
        "scripts/check-full-wiki-cms.mjs"
      ],
      "guards": [
        "check:full-wiki-cms"

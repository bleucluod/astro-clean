{
  "schemaVersion": 1,
  "baseline": {
    "description": "Fast repository-wide safeguards required for every non-empty change set.",
    "guards": [
      "check:encoding",
      "check:workflow-acceleration"
    ]
  },
  "fallback": {
    "description": "Fail-safe policy for paths that are not yet registered.",
    "guards": [],
    "lint": true,
    "build": true
  },
  "areas": [
    {
      "id": "sky-daily-contract",
      "description": "Canonical daily-sky contract and its deterministic guard.",
      "patterns": ["lib/sky-daily/**", "scripts/check-sky-daily-contract.mjs"],
      "guards": ["check:sky-daily-contract"],
      "lint": true,
      "build": true
    },
    {
      "id": "documentation",
      "description": "Repository documentation with no production runtime effect.",
      "patterns": [
        "**/*.md",
        "docs/**"
      ],
      "guards": [],
      "lint": false,
      "build": false
    },
    {
      "id": "workflow-core",
      "description": "Shared impact planner, verifier, workflow contract, and text-policy files.",
      "exclusive": true,
      "patterns": [
        "config/halleus-check-impact.json",
        "scripts/halleus-check-plan.mjs",
        "scripts/halleus-verify.mjs",
        "scripts/check-workflow-optimization.mjs",
        "scripts/check-workflow-acceleration.mjs",
        ".github/workflows/halleus-verify.yml",
        ".gitattributes",
        ".editorconfig"
      ],
      "guards": [
        "check:workflow"
      ],
      "lint": false,
      "build": false
    },
    {
      "id": "workflow-tooling",
      "description": "Shared check planner, guard scripts, CI, and repository text policy.",
      "patterns": [
        "config/halleus-check-impact.json",
        "scripts/**",
        ".github/workflows/**",
        ".gitattributes",
        ".editorconfig",
        "package.json"
      ],
      "guards": [
        "check:workflow"
      ],
      "lint": true,
      "build": false
    },
    {
      "id": "project-configuration",
      "description": "Dependency and compiler configuration can alter every production route.",
      "patterns": [
        "package.json",
        "pnpm-lock.yaml",
        "next.config.*",
        "tsconfig*.json",
        "eslint.config.*",
        "postcss.config.*",
        ".env.example"
      ],
      "guards": [],
      "lint": true,
      "build": true
    },
    {
      "id": "runtime",
      "description": "Application runtime, shared libraries, types, and public assets.",
      "patterns": [
        "app/**",
        "components/**",
        "lib/**",
        "src/**",
        "types/**",
        "public/**"
      ],
      "guards": [],
      "lint": true,
      "build": true
    },
    {
      "id": "ui",
      "description": "User-facing pages, components, and styles.",
      "patterns": [
        "app/**/*.tsx",
        "app/**/*.css",
        "components/**"
      ],
      "guards": [
        "check:product-surface"
      ],
      "lint": true,
      "build": true
    },
    {
      "id": "engine",
      "description": "Chart and astrology calculation contracts.",
      "patterns": [
        "app/api/engine/**",
        "app/engine/**",
        "lib/astro-engine/**",
        "lib/astrology/**",
        "lib/chart-engine/**",
        "src/lib/chart/**",
        "types/*engine*.ts"
      ],
      "guards": [
        "check:chart-engine",
        "check:chart-engine-integration",
        "check:real-chart-normalization"
      ],
      "lint": true,
      "build": true
    },
    {
      "id": "reports",
      "description": "Report generation, output, preview, and quality contracts.",
      "patterns": [
        "app/reports/**",
        "components/ManualOrderRequestForm.tsx",
        "components/PersonalTransitReportSection.tsx",
        "components/Report*.tsx",
        "components/ReportsList.tsx",
        "lib/report-*/**",
        "src/lib/report-output/**",
        "types/report-*.ts"
      ],
      "guards": [
        "check:report-quality"
      ],
      "lint": true,
      "build": true
    },
    {
      "id": "auth-admin-account",
      "description": "Authentication, account identity, admin authorization, and audit boundaries.",
      "patterns": [
        "app/admin/**",
        "app/api/admin/**",
        "components/admin/**",
        "components/SupabaseAuthPanel.tsx",
        "lib/admin/**",
        "lib/auth/**",
        "lib/account/**",
        "types/auth.ts",
        "types/account.ts"
      ],
      "guards": [
        "check:secure-admin-core",
        "check:admin-origin-boundary",
        "check:auth-readiness"
      ],
      "lint": true,
      "build": true
    },
    {
      "id": "report-wheel",
      "description": "Stored report chart wheel rendering and fallbacks.",
      "patterns": [
        "components/ReportBirthChartWheel.tsx"
      ],
      "guards": [
        "check:report-birth-chart-wheel"
      ],
      "lint": true,
      "build": true
    },
    {
      "id": "personal-transit-guard-tooling",
      "description": "Focused personal transit relevance guard implementation.",
      "patterns": [
        "scripts/check-personal-transit-relevance-interpretation.mjs"
      ],
      "guards": [
        "check:personal-transit-relevance-interpretation"
      ],
      "lint": true,
      "build": false
    },
    {
      "id": "storage-database",
      "description": "Persistent storage adapters, database access, migrations, and seeds.",
      "patterns": [
        "database/**",
        "lib/database/**",
        "lib/storage/**",
        "types/storage.ts"
      ],
      "guards": [
        "check:storage",
        "check:database"
      ],
      "lint": true,
      "build": true
    },
    {
      "id": "wiki",
      "description": "Public Wiki, CMS, storage, import, media, and publication behavior.",
      "patterns": [
        "app/wiki/**",
        "app/api/admin/wiki/**",
        "app/api/internal/wiki/**",
        "components/admin/WikiAdminPanel.tsx",
        "lib/wiki/**",
        "lib/config/wiki.ts",
        "database/migrations/*wiki*.sql",
        "database/seeds/*wiki*.sql",
        "public/*wiki*.md",
        "ops/vps/*wiki*"
      ],
      "guards": [
        "check:wiki-content-foundation",
        "check:wiki-storage-public-read",
        "check:wiki-package-security",
        "check:wiki-scheduling-determinism",
        "check:full-wiki-cms",
        "check:wiki-publication-queue-readonly",
        "check:wiki-bulk-scheduling",
        "check:wiki-bulk-actions-ui",
        "check:wiki-queue-operations",
        "check:wiki-queue-priority",
        "check:wiki-content-guide-priority"
      ],
      "lint": true,
      "build": true
    },
    {
      "id": "wiki-public-surface",
      "description": "Public Wiki routes and public-facing Wiki configuration.",
      "exclusive": true,
      "patterns": [
        "app/wiki/**",
        "lib/config/wiki.ts"
      ],
      "guards": [
        "check:product-surface",
        "check:wiki-content-foundation",
        "check:wiki-storage-public-read",
        "check:full-wiki-cms"
      ],
      "lint": true,
      "build": true
    },
    {
      "id": "wiki-admin-ui",
      "description": "Wiki admin page and queue controls rendered in the protected admin UI.",
      "exclusive": true,
      "patterns": [
        "app/admin/wiki/**",
        "components/admin/WikiAdminPanel.tsx"
      ],
      "guards": [
        "check:product-surface",
        "check:secure-admin-core",
        "check:admin-origin-boundary",
        "check:auth-readiness",
        "check:full-wiki-cms",
        "check:wiki-publication-queue-readonly",
        "check:wiki-bulk-scheduling",
        "check:wiki-bulk-actions-ui",
        "check:wiki-queue-operations",
        "check:wiki-queue-priority",
        "check:wiki-content-guide-priority"
      ],
      "lint": true,
      "build": true
    },
    {
      "id": "wiki-package-import",
      "description": "Wiki package parsing, validation, import, and package contract routes.",
      "exclusive": true,
      "patterns": [
        "app/api/admin/wiki/packages/**",
        "app/api/admin/wiki/import/**",
        "lib/wiki/wiki-package.ts",
        "public/halleus-wiki-package-guide-v1.md"
      ],
      "guards": [
        "check:secure-admin-core",
        "check:admin-origin-boundary",
        "check:auth-readiness",
        "check:wiki-package-security",
        "check:full-wiki-cms",
        "check:wiki-content-guide-priority"
      ],
      "lint": true,
      "build": true
    },
    {
      "id": "wiki-content-guide",
      "description": "Live Wiki AI content guide and its queue-aware priority contract.",
      "exclusive": true,
      "patterns": [
        "app/api/admin/wiki/content-guide/**",
        "lib/wiki/wiki-content-guide.ts"
      ],
      "guards": [
        "check:secure-admin-core",
        "check:admin-origin-boundary",
        "check:auth-readiness",
        "check:full-wiki-cms",
        "check:wiki-queue-priority",
        "check:wiki-content-guide-priority"
      ],
      "lint": true,
      "build": true
    },
    {
      "id": "wiki-guard-tooling",
      "description": "Focused Wiki guards without a production runtime change.",
      "patterns": [
        "scripts/check-*wiki*.mjs"
      ],
      "guards": [
        "check:wiki-content-foundation",
        "check:wiki-storage-public-read",
        "check:wiki-package-security",
        "check:wiki-scheduling-determinism",
        "check:full-wiki-cms",
        "check:wiki-publication-queue-readonly",
        "check:wiki-bulk-scheduling",
        "check:wiki-bulk-actions-ui",
        "check:wiki-queue-operations",
        "check:wiki-queue-priority",
        "check:wiki-content-guide-priority"
      ],
      "lint": true,
      "build": false
    },
    {
      "id": "wiki-content-foundation-guard",
      "description": "Focused self-verification for check:wiki-content-foundation.",
      "exclusive": true,
      "patterns": [
        "scripts/check-wiki-content-foundation.mjs"
      ],
      "guards": [
        "check:wiki-content-foundation"
      ],
      "lint": false,
      "build": false
    },
    {
      "id": "wiki-storage-public-read-guard",

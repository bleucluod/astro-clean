# HALLEUS_STORAGE_BOUNDED_RELEASE_V1
# Baselines measured from production current/previous on 2026-10-09.
HALLEUS_STORAGE_CONTRACT_VERSION=1
HALLEUS_RUNTIME_BASELINE_BYTES=631951323
# 2026-11-11 BitPay production build (post-cache-prune) measured 739118528 bytes.
# Retain bounded two-release/headroom policy; permit a narrow 710 MiB runtime cap.
HALLEUS_RUNTIME_BUDGET_BYTES=744488960
HALLEUS_DEPENDENCY_BUDGET_BYTES=452984832
# 2026-11-01 closeout build measured 220640801 bytes after cache prune;
# 2026-11-06 P01 closed build measured 224064535 bytes after cache prune.
# 2026-11-10 merchant-schema build measured 228260666 bytes after cache prune.
# 2026-11-11 full BitPay release build measured 228666461 bytes after cache prune.
# Permit 222 MiB for Next.js output with margin; the independent 710 MiB
# total release cap and all other storage guards remain unchanged.
HALLEUS_BUILD_OUTPUT_BUDGET_BYTES=232783872
# 2026-11-10 P02 gallery build measured 4410973 public bytes.
# Allow 4.5 MiB for public assets; retain the existing 710 MiB total release cap.
HALLEUS_PUBLIC_BUDGET_BYTES=4718592
HALLEUS_HEADROOM_RUNTIME_COPIES=2
HALLEUS_KEEP_RELEASES=2

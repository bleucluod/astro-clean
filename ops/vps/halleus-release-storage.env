# HALLEUS_STORAGE_BOUNDED_RELEASE_V1
# Baselines measured from production current/previous on 2026-10-09.
HALLEUS_STORAGE_CONTRACT_VERSION=1
HALLEUS_RUNTIME_BASELINE_BYTES=631951323
# 2026-11-11 BitPay production build (post-cache-prune) measured 739118528 bytes.
# 2026-11-14 analytics build measured 745621505 bytes after safe cache pruning.
# Permit 714 MiB (4 MiB over prior cap), keeping two-release headroom intact.
# Shared NM galleries and chart/shop assets require bounded extra public headroom.
# Runtime cap: 725 MiB; actual free-disk / inode preflight still enforces 2 copies.
HALLEUS_RUNTIME_BUDGET_BYTES=760217600
HALLEUS_DEPENDENCY_BUDGET_BYTES=452984832
# 2026-11-01 closeout build measured 220640801 bytes after cache prune;
# 2026-11-06 P01 closed build measured 224064535 bytes after cache prune.
# 2026-11-10 merchant-schema build measured 228260666 bytes after cache prune.
# 2026-11-11 full BitPay release build measured 228666461 bytes after cache prune.
# 2026-11-13 published-showcase copy panel build: 233971009 bytes after cache pruning.
# 2026-11-14 sky observatory release (after cache prune): 236683162 bytes.
# 2026-11-18 NM/chart full production build measured 239753548 bytes after
# the existing build-cache prune, exceeding the old 227 MiB sub-cap by 1726796.
# Allow 230 MiB for Next.js output. The 725 MiB total runtime cap and other
# component caps, two-release headroom, and retention remain unchanged.
HALLEUS_BUILD_OUTPUT_BUDGET_BYTES=241172480
# 2026-11-10 P02 gallery build measured 4410973 public bytes.
# Allow 4.5 MiB for public assets; retain the existing 710 MiB total release cap.
# Git tree on 2026-11-18 contains 10,102,934 bytes of public files.
# 12 MiB leaves <2.5 MiB bounded slack for Next public packaging overhead.
HALLEUS_PUBLIC_BUDGET_BYTES=12582912
HALLEUS_HEADROOM_RUNTIME_COPIES=2
HALLEUS_KEEP_RELEASES=2

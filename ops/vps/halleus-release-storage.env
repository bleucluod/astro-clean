# 2026-11-13 published-showcase copy panel build: 233971009 bytes after cache pruning.
# 2026-11-14 sky observatory release (after cache prune): 236683162 bytes.
# Allow 227 MiB for Next.js build output (1.34 MiB above measured candidate).
# The independent 714 MiB total runtime cap, dependency/public caps, and
# two-release storage headroom remain unchanged.
HALLEUS_BUILD_OUTPUT_BUDGET_BYTES=238026752
# 2026-11-10 P02 gallery build measured 4410973 public bytes.
# Allow 4.5 MiB for public assets; retain the existing 710 MiB total release cap.

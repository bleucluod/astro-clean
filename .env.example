NEXT_PUBLIC_HALLEUS_SITE_URL=https://halleus.ir
NEXT_PUBLIC_HALLEUS_BRAND_NAME=Halleus

# Later database connection
DATABASE_URL=

# Guarded beta database persistence
HALLEUS_ENABLE_BETA_PERSISTENCE=false
HALLEUS_BETA_PERSISTENCE_USER_ID=
NEXT_PUBLIC_HALLEUS_ENABLE_BETA_DB_SAVE_UI=false

# Later auth configuration
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Later payment configuration
PAYMENT_PROVIDER=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
# Selected future auth/storage direction (not enabled until driver is implemented)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Guarded future account mode switches
HALLEUS_ENABLE_SUPABASE_AUTH_STUB=false
HALLEUS_ENABLE_ACCOUNT_STORAGE=false
# Guarded real Supabase login shell
NEXT_PUBLIC_HALLEUS_ENABLE_SUPABASE_LOGIN=false
# Guarded user-owned account report save path
NEXT_PUBLIC_HALLEUS_ENABLE_ACCOUNT_REPORT_SAVE=false
# Real Supabase account flow local test
# Required together for signup -> login -> account save -> account reports read:
# NEXT_PUBLIC_HALLEUS_ENABLE_SUPABASE_LOGIN=true
# NEXT_PUBLIC_HALLEUS_ENABLE_ACCOUNT_REPORT_SAVE=true
# HALLEUS_ENABLE_ACCOUNT_STORAGE=true
# DATABASE_URL=...
# AUTH_SECRET=...
# NEXT_PUBLIC_SUPABASE_URL=...
# NEXT_PUBLIC_SUPABASE_ANON_KEY=...
# SUPABASE_SERVICE_ROLE_KEY=...
# Username is user-chosen; mobile is collected but is not the username; email is optional/secondary.

# Telegram publishing through the Cloudflare Worker bridge
HALLEUS_TELEGRAM_BRIDGE_URL=
HALLEUS_TELEGRAM_BRIDGE_SECRET=
HALLEUS_TELEGRAM_PUBLISHER_SECRET=
# TELEGRAM_BOT_TOKEN and TELEGRAM_CHANNEL_ID belong only in Cloudflare Worker secrets.

# Telegram join reward public links (non-secret)
HALLEUS_TELEGRAM_BOT_USERNAME=h4ll3usbot
HALLEUS_TELEGRAM_CHANNEL_URL=https://t.me/Halleus_astro

# Direct private admin login (/admini). Keep real values only in server env/.env.local.
HALLEUS_ADMIN_DIRECT_USERNAME=
HALLEUS_ADMIN_DIRECT_PASSWORD_HASH=
HALLEUS_ADMIN_DIRECT_SESSION_SECRET=
# Optional when more than one active owner exists. Must be an existing owner UUID.
HALLEUS_ADMIN_DIRECT_USER_ID=

# Optional public-discovery ping for Bing/IndexNow-compatible search engines.
# Host verification is served from /indexnow-key.txt when configured.
HALLEUS_INDEXNOW_KEY=